<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="10"
            VerticalOptions="Start">
            <HorizontalStackLayout VerticalOptions="Start">
                
            <Label Text="Najbliższa stacja: "
                   FontSize="28"/>
            <Label x:Name="nearestStation"
                   FontAttributes="Bold"
                   FontSize="28"/>
            </HorizontalStackLayout>
            <GraphicsView
                x:Name="graphicsView"
                WidthRequest="140"
                HeightRequest="140"
                HorizontalOptions="Center"
                VerticalOptions="Center"                
                >
            </GraphicsView>

            
            <Button 
                Text="Uruchom kompas"
                Clicked="Button_Clicked"
                />
            <Label FontSize="18" x:Name="stationData"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
